{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slotiva",
  "preview_urls": true,
  "main": "worker/index.ts",
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slotiva-db",
      "database_id": "64f5ebf5-6e63-4328-b867-9462a5a97257",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "COOKIE_SECURE": "true", "AUTH_MODE": "demo" },
  // No D1 inheritance: configure a dedicated product-homologation database
  // before enabling writes. The older Preview database must remain untouched.
  "previews": {
    "vars": { "COOKIE_SECURE": "true", "AUTH_MODE": "google" },
    "d1_databases": []
  }
}
