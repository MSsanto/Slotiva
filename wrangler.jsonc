{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slotiva",
  "preview_urls": true,
  "main": "worker/index.ts",
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slotiva-db",
      "database_id": "64f5ebf5-6e63-4328-b867-9462a5a97257",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "COOKIE_SECURE": "true", "AUTH_MODE": "demo" },
  // Dedicated product-homologation D1; production and the older Preview stay separate.
  // Apply migrations with the matching PREVIEW_DB config before testing this Preview.
  "previews": {
    "vars": { "COOKIE_SECURE": "true", "AUTH_MODE": "google" },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "slotiva-product-homologation",
        "database_id": "74b37b6b-7f9e-40a3-b685-546d7a0a76ac",
        "migrations_dir": "migrations"
      }
    ]
  }
}
